#!/usr/bin/env python3
"""Run ios-safari-mcp from a checkout, without installing it: bin/ios-safari-mcp [serve|doctor|build-image|version]"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), 'src'))
from ios_safari_mcp.cli import main  # noqa: E402

sys.exit(main())
