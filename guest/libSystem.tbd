--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios ]
install-name:    '/usr/lib/libSystem.B.dylib'
current-version: 1311
exports:
  - targets:         [ arm64-ios ]
    symbols:         [ _xpc_connection_create_mach_service, _xpc_connection_set_event_handler, _xpc_connection_resume,
                       _xpc_connection_send_message, _xpc_dictionary_create, _xpc_dictionary_set_string,
                       _xpc_dictionary_set_bool, _xpc_dictionary_set_fd, _xpc_dictionary_set_value,
                       _xpc_date_create_from_current, _xpc_copy_description, _xpc_get_type, _xpc_dictionary_get_data,
                       _xpc_dictionary_set_data, _xpc_retain, _xpc_release, __xpc_type_connection,
                       __xpc_type_dictionary, __xpc_type_error, _malloc, _pthread_mutex_lock,
                       _pthread_mutex_unlock, _pthread_mutex_init, _shutdown, _xpc_connection_cancel, __xpc_type_data, _dlopen, _dlsym, _dispatch_async, _strncmp, _strlen, _memmem, _memcpy, _xpc_dictionary_get_value, _xpc_dictionary_apply, _xpc_data_get_length,
                       _xpc_data_get_bytes, _notify_register_dispatch, _dispatch_get_global_queue, __Block_object_assign, __Block_object_dispose,
                       _socket, _bind, _listen, _accept, _setsockopt, _socketpair, _read, _write, _close, _poll,
                       _dprintf, _signal, ___error, _memset, _atoi, _free, _notify_post, __NSConcreteGlobalBlock,
                       __NSConcreteStackBlock, ___stack_chk_fail, ___stack_chk_guard, dyld_stub_binder ]
...
